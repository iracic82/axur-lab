# Paste your Axur API key after the = (Axur ONE → My Preferences → API KEY). No quotes needed.
AXUR_TOKEN=

# Optional overrides (defaults shown)
# Tenant name: Instruqt sets INSTRUQT_SANDBOX_ID; for local runs override with AXUR_TENANT_NAME
#AXUR_TENANT_NAME=local-test
#AXUR_PARTNER_KEY=IE2L
#AXUR_SEGMENT=            # empty = random per tenant
#AXUR_BRAND_NAME=         # default: the sandbox id
#AXUR_BRAND_WEBSITE=www.infoblox.com
AXUR_CTI_ENABLED=true
#AXUR_BILLING_COUNTRY=ES

# user_provision.py — Axur registration endpoint POST /api/identity/registration/users/{tenant}
#USER_DOMAIN=infoblox.lab
#AXUR_USER_GROUP=manager          # or viewer
#AXUR_USER_FIRSTNAME=Lab
#AXUR_USER_DELETE_PATH=           # none yet; set when Axur provides one
