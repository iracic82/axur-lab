#!/bin/bash
# Challenge 2 solve (runs when a participant skips): Axur has no API to quarantine or discard a ticket on the
# participant's behalf, so skipping records a marker that the check script honours.
set -euo pipefail
mkdir -p /root/lab
echo "skipped $(date -u +%FT%TZ)" > /root/lab/challenge2.solved
echo "challenge 2 marked as solved"
